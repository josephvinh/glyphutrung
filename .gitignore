# PHPUnit runtime cache
.phpunit.result.cache

# Node (chỉ dùng để build minify — không cần trên host)
node_modules/

# File-based cache runtime data
public/cache/*.json
public/cache/*.txt

# Script debug tạm của agent — KHÔNG đưa lên host (chạy shell_exec / lộ mã nguồn)
public/find_modified*.php
public/git_check_ai.php
public/git_diff_sw.php
public/test_runner_ai.php

# Claude workspace artifacts
.superpowers/
.claude/launch.json

# Bảng đối chiếu migration (chứa tên thật — không đưa lên repo)
config/backup/

# Cấu hình riêng máy chủ/máy nhà — KHÔNG lên git
config/config.local.php

# Bundle minified (tự build bằng npm run build; không track vì bundle.php
# nối source nếu file này thiếu hoặc cũ)
public/assets/js/bundle.min.js
public/assets/js/login.min.js

# ============================================================
# DEVELOPMENT ONLY — KHÔNG PUSH LÊN HOST
# ============================================================

# CI/CD workflows (chạy trên GitHub, không cần trên host)
# .github/ - GIỮ LẠI TRONG GIT để GitHub Actions hoạt động

# Claude Code workspace files
REVIEW_RESULTS/

# Development artifacts (build tools, tests, docs - không cần trên production)
build/
tests/
docs/
scratch/

# PHPUnit
phpunit10.phar
phpunit.xml

# Dev config files
tsconfig.json
package.json
package-lock.json

# Claude workspace directories
"NGOC VINH"/
"[working-dir] NGOC VINH"/
Enter/

# Documentation
CLAUDE.md
CHANGES_SUMMARY.md

# Runtime logs (không commit log chạy máy)
logs/*.log
# Nhật ký lỗi PHP của máy chủ (tệp `error_log` không đuôi, ở mọi thư mục) — có thể chứa đường dẫn, SQL, dữ liệu
error_log
*/error_log

# ============================================================
# RÁC Ở GỐC REPO — đã gỡ khỏi git, chặn không cho commit lại.
# (Các dòng "NGOC VINH"/ ở trên viết sai cú pháp — dấu ngoặc kép
# bị hiểu theo nghĩa đen — nên các mục dưới đây mới là bản đúng.)
# ============================================================
test-code/
/cookies.txt
/error_log
/master/
/master
/Enter
/NGOC VINH/
/\[working-dir\] NGOC VINH/
/*.sql
/CHANGES_SUMMARY.md
/CONTRIBUTING.md
/SPEC-*.md
/public/**/*.md
