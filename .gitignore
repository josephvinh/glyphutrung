# PHPUnit runtime cache
.phpunit.result.cache

# Node (chỉ dùng để build minify — không cần trên host)
node_modules/

# File-based cache runtime data
public/cache/*.json
public/cache/*.txt

# Script debug tạm của agent — KHÔNG đưa lên host (chạy shell_exec / lộ mã nguồn)
public/find_modified*.php
public/git_check_ai.php
public/git_diff_sw.php
public/test_runner_ai.php

# Claude workspace artifacts
.superpowers/sdd/
.claude/launch.json

# Bảng đối chiếu migration (chứa tên thật — không đưa lên repo)
config/backup/

# Cấu hình riêng máy chủ/máy nhà — KHÔNG lên git
config/config.local.php

# Bundle minified: GIỜ ĐƯỢC TRACK và commit (giống bundle.min.css).
# Lý do: deploy chỉ rsync (scripts/deploy.sh), KHÔNG chạy `npm run build`.
# Trước đây hai tệp này bị ignore -> không bao giờ có trên host:
#   - bundle.min.js  : bundle.php rơi về nối thô CHƯA minify (287KB thay vì ~143KB)
#   - login.min.js   : layout_login.php nạp THẲNG (không fallback) -> nguy cơ 404
# Commit tệp .min bảo đảm host luôn có bản minify. bundle.php vẫn tự bỏ qua bản
# min nếu nó CŨ hơn nguồn (nối thô) nên min lỡ cũ cũng không phục vụ mã sai.
# => Sau khi sửa JS: chạy `npm run build` rồi commit lại tệp .min.
