{
  "name": "tntt",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node build/minify.cjs",
    "build:css": "node build/minify.cjs --css-only",
    "build:js": "node build/minify.cjs --js-only",
    "optimize:images": "node build/optimize_images.cjs",
    "optimize": "npm run build && npm run optimize:images",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit --project tsconfig.json 2>&1 || true",
    "test": "php tests/UnitTest.php && npx playwright test",
    "test:unit": "php tests/UnitTest.php",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:coverage": "php phpunit10.phar --coverage-html coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephvinh/glyphutrung.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/josephvinh/glyphutrung/issues"
  },
  "homepage": "https://github.com/josephvinh/glyphutrung#readme",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.33.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "color": "^4.2.3",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "color-string": "^1.9.1",
    "detect-libc": "^2.1.2",
    "is-arrayish": "^0.3.4",
    "semver": "^7.8.5",
    "simple-swizzle": "^0.2.4"
  }
}
